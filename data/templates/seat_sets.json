{
  "description": "SEAT-style sentence sets for experiment E2. Target terms are inserted into semantically bleached frames (May et al., 2019); attribute words are task-aligned legal concepts, plus the generic pleasant/unpleasant valence test of Caliskan et al. (2017) as a baseline.",
  "explicit_frames": [
    "This is a {T}.", "That is a {T}.", "There is a {T}.", "Here is a {T}.",
    "The {T} is here.", "The {T} is there.", "The person is a {T}.",
    "A {T} lives here.", "The defendant is a {T}.", "The witness is a {T}."
  ],
  "explicit_terms": {
    "M_het_exp": "heterosexual man", "M_gay_exp": "gay man", "M_bi_exp": "bisexual man",
    "F_het_exp": "heterosexual woman", "F_les_exp": "lesbian woman", "F_bi_exp": "bisexual woman"
  },
  "implicit_frames": [
    "{He} lives with {his} {S}.", "{He} is married to {his} {S}.",
    "{He} came to court with {his} {S}.", "{His} {S} is waiting outside.",
    "{He} and {his} {S} live together.", "{He} called {his} {S}.",
    "{He} was seen with {his} {S}.", "{He} moved to the city with {his} {S}.",
    "{He} spent the weekend with {his} {S}.", "{He} has been with {his} {S} for years."
  ],
  "attribute_frames": ["This person is {w}.", "That person is {w}.", "The person is {w}."],
  "concepts": {
    "REC": {
      "name": "dangerous-harmless",
      "negative": ["dangerous", "violent", "aggressive", "threatening", "reckless", "hostile", "menacing", "criminal"],
      "positive": ["harmless", "peaceful", "gentle", "calm", "careful", "friendly", "safe", "law-abiding"]
    },
    "PRE": {
      "name": "guilty-innocent",
      "negative": ["guilty", "culpable", "blameworthy", "delinquent", "immoral", "corrupt", "wicked", "crooked"],
      "positive": ["innocent", "blameless", "guiltless", "upright", "moral", "decent", "virtuous", "righteous"]
    },
    "CRED": {
      "name": "dishonest-credible",
      "negative": ["dishonest", "deceitful", "untruthful", "unreliable", "untrustworthy", "insincere", "lying", "manipulative"],
      "positive": ["honest", "truthful", "reliable", "trustworthy", "credible", "sincere", "believable", "candid"]
    }
  },
  "pre_split": {
    "legal": {
      "name": "legal culpability",
      "negative": ["guilty", "culpable", "blameworthy", "delinquent"],
      "positive": ["innocent", "blameless", "guiltless", "upright"]
    },
    "moral": {
      "name": "moral judgement",
      "negative": ["immoral", "corrupt", "wicked", "crooked"],
      "positive": ["moral", "decent", "virtuous", "righteous"]
    }
  },
  "baseline": {
    "name": "unpleasant-pleasant (Caliskan et al., 2017)",
    "frames": ["This is {w}.", "That is {w}.", "There is {w}."],
    "negative": ["agony", "terrible", "horrible", "nasty", "evil", "war", "awful", "failure"],
    "positive": ["joy", "love", "peace", "wonderful", "pleasure", "friend", "laughter", "happy"]
  },
  "neutral_reference": [
    "The weather was cold this morning.", "The meeting starts at ten o'clock.",
    "The train arrived at the station.", "She bought bread and milk.",
    "The report has twelve pages.", "The office is on the third floor.",
    "He read the newspaper.", "The car is parked outside.",
    "They walked along the river.", "The book is on the table."
  ]
}
